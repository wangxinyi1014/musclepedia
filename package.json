{
  "name": "fit-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fit Atlas — 1324 个健身动作的可视化查询与训练计划工具，基于 exercises-dataset 构建",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/copy-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "data:build": "python3 scripts/build_data.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
